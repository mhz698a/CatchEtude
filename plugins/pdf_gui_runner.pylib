"""
GUI Runner and Non-Modal Progress Dialog for PDF Operations in CatchEtude.
Ejecutor GUI y diálogo de progreso no modal para operaciones de PDF en CatchEtude.
"""

import importlib.util
import logging
import shutil
import sys
import tempfile
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path
from typing import List, Optional

from PyQt6 import QtCore, QtWidgets
from PyQt6.QtCore import Qt, QThread, pyqtSignal, pyqtSlot

import config
from utils import resolve_duplicate


def _load_private_library(module_name: str, filename: str):
    """Load a plugin-private helper from this directory without adding root modules."""
    existing = sys.modules.get(module_name)
    if existing is not None:
        return existing

    library_path = Path(__file__).with_name(filename)
    loader = SourceFileLoader(module_name, str(library_path))
    spec = importlib.util.spec_from_loader(module_name, loader)
    if spec is None or spec.loader is None:
        raise ImportError(f"Could not load plugin library: {library_path}")

    module = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = module
    try:
        spec.loader.exec_module(module)
    except Exception:
        sys.modules.pop(module_name, None)
        raise
    return module


pdf_tools_mgr = _load_private_library(
    "catchetude_pdf_tools_mgr", "pdf_tools_mgr.pylib"
)
file_conversion_mgr = _load_private_library(
    "catchetude_file_conversion_mgr", "file_conversion_mgr.pylib"
)


# A non-modal QDialog is not kept alive by Qt after the local Python reference
# disappears.  Keep active tasks here until their dialog is destroyed.
_ACTIVE_PDF_DIALOGS = set()


class PDFWorkerThread(QThread):
    """
    Background worker thread executing PDF tasks without freezing the GUI.
    """
    progress_updated = pyqtSignal(int, int, str, bool)  # current, total, detail, indeterminate
    finished_success = pyqtSignal(list, list)  # produced_files in temp, warning_messages
    finished_error = pyqtSignal(str)
    cancelled = pyqtSignal()

    def __init__(
        self,
        task_type: str,
        files: List[Path],
        dpi: int = 150,
        parent: Optional[QtCore.QObject] = None
    ):
        super().__init__(parent)
        self.task_type = task_type
        self.files = files
        self.dpi = dpi
        self._is_cancelled = False

    def request_cancellation(self):
        self._is_cancelled = True

    def _check_cancelled(self) -> bool:
        return self._is_cancelled

    def cleanup_temp(self):
        if hasattr(self, "temp_dir_obj") and self.temp_dir_obj:
            try:
                self.temp_dir_obj.cleanup()
            except Exception as e:
                logging.debug(f"Error cleaning up temp directory: {e}")
            self.temp_dir_obj = None

    def run(self):
        self.temp_dir_obj = tempfile.TemporaryDirectory()
        temp_dir = Path(self.temp_dir_obj.name)

        try:
            warnings: List[str] = []
            produced_temp_files: List[Path] = []

            def _progress(cur, tot, message=None, indeterminate=False):
                detail = message or f"Procesando {self.task_type}…"
                self.progress_updated.emit(int(cur), int(tot), str(detail), bool(indeterminate))

            task_labels = {
                "imgs_to_pdf": "Preparando imágenes para PDF…",
                "pdf_to_jpeg": "Preparando renderizado de páginas PDF…",
                "extract_images": "Analizando imágenes incrustadas en PDF…",
                "merge_pdfs": "Preparando unión de documentos PDF…",
                "images_to_ico": "Convirtiendo imágenes a ICO…",
                "images_to_png": "Convirtiendo imágenes a PNG…",
                "images_to_jpg": "Convirtiendo imágenes a JPG…",
                "svg_to_png": "Renderizando SVG como PNG…",
                "svg_to_ico": "Renderizando SVG como ICO…",
                "audio_to_mp3": "Preparando conversión de audio a MP3…",
                "word_to_pdf": "Iniciando conversión de Word a PDF en segundo plano…",
            }
            _progress(0, max(1, len(self.files)), task_labels.get(self.task_type, "Preparando conversión…"), True)

            if self.task_type == "imgs_to_pdf":
                out_file = pdf_tools_mgr.images_to_pdf(
                    self.files,
                    temp_dir,
                    cancel_check=self._check_cancelled,
                    progress_cb=_progress
                )
                produced_temp_files.append(out_file)

            elif self.task_type == "pdf_to_jpeg":
                produced_temp_files = pdf_tools_mgr.pdf_to_jpeg(
                    self.files,
                    temp_dir,
                    dpi=self.dpi,
                    cancel_check=self._check_cancelled,
                    progress_cb=_progress
                )

            elif self.task_type == "extract_images":
                produced_temp_files, warnings = pdf_tools_mgr.extract_pdf_images(
                    self.files,
                    temp_dir,
                    cancel_check=self._check_cancelled,
                    progress_cb=_progress
                )

            elif self.task_type == "merge_pdfs":
                out_file = pdf_tools_mgr.merge_pdfs(
                    self.files,
                    temp_dir,
                    cancel_check=self._check_cancelled,
                    progress_cb=_progress
                )
                produced_temp_files.append(out_file)


            elif self.task_type in {
                "images_to_ico",
                "images_to_png",
                "images_to_jpg",
                "svg_to_png",
                "svg_to_ico",
                "audio_to_mp3",
                "word_to_pdf",
            }:
                produced_temp_files, warnings = file_conversion_mgr.run_file_conversion(
                    self.task_type,
                    self.files,
                    temp_dir,
                    cancel_check=self._check_cancelled,
                    progress_cb=_progress,
                )

            else:
                raise ValueError(f"Unknown PDF task type: {self.task_type}")

            if self._is_cancelled:
                self.cancelled.emit()
            else:
                self.finished_success.emit(produced_temp_files, warnings)

        except InterruptedError:
            logging.info("PDF worker process cancelled by user")
            self.cancelled.emit()
        except Exception as e:
            logging.exception("Error executing PDF task in worker thread")
            if not self._is_cancelled:
                self.finished_error.emit(str(e))
            else:
                self.cancelled.emit()
        finally:
            # Note: TemporaryDirectory will be cleaned up on deletion
            pass


class PDFProgressDialog(QtWidgets.QDialog):
    """
    Non-modal progress dialog allowing CatchEtude to remain interactive.
    """
    def __init__(self, title: str, task_type: str, files: List[Path], parent: Optional[QtWidgets.QWidget] = None):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.setMinimumWidth(380)
        self.setWindowModality(Qt.WindowModality.NonModal)
        self.setWindowFlags(self.windowFlags() & ~Qt.WindowType.WindowContextHelpButtonHint)

        self.task_type = task_type
        self.files = files
        self.worker: Optional[PDFWorkerThread] = None
        self._close_after_worker_stops = False
        self._started_at = None

        self._build_ui()

    def _build_ui(self):
        layout = QtWidgets.QVBoxLayout(self)

        self.lbl_status = QtWidgets.QLabel("Preparando conversión…")
        self.lbl_status.setWordWrap(True)
        layout.addWidget(self.lbl_status)

        self.lbl_elapsed = QtWidgets.QLabel("Tiempo transcurrido: 0 s")
        self.lbl_elapsed.setAlignment(Qt.AlignmentFlag.AlignRight)
        layout.addWidget(self.lbl_elapsed)

        self._elapsed_timer = QtCore.QTimer(self)
        self._elapsed_timer.setInterval(1000)
        self._elapsed_timer.timeout.connect(self._update_elapsed_time)

        self.progress_bar = QtWidgets.QProgressBar()
        self.progress_bar.setRange(0, 100)
        self.progress_bar.setValue(0)
        layout.addWidget(self.progress_bar)

        btn_layout = QtWidgets.QHBoxLayout()
        btn_layout.addStretch()
        self.btn_cancel = QtWidgets.QPushButton("Cancelar")
        self.btn_cancel.clicked.connect(self._on_cancel_clicked)
        btn_layout.addWidget(self.btn_cancel)

        layout.addLayout(btn_layout)

    def start_task(self, dpi: int = 150):
        self._started_at = time.monotonic()
        self._elapsed_timer.start()
        self._update_elapsed_time()
        self._on_progress_updated(
            0,
            max(1, len(self.files)),
            "Preparando el trabajo en el hilo secundario…",
            True,
        )

        self.worker = PDFWorkerThread(self.task_type, self.files, dpi=dpi, parent=self)
        self.worker.progress_updated.connect(self._on_progress_updated)
        self.worker.finished_success.connect(self._on_finished_success)
        self.worker.finished_error.connect(self._on_finished_error)
        self.worker.cancelled.connect(self._on_cancelled)
        # Result signals can be delivered just before QThread has fully exited.
        # Closing this dialog in a result slot would then destroy its child
        # worker prematurely and abort the plugin process ("QThread: Destroyed
        # while thread is still running").
        self.worker.finished.connect(self._close_after_worker_finished)
        self.show()
        self.worker.start()

    def _update_elapsed_time(self):
        if self._started_at is None:
            return
        elapsed = max(0, int(time.monotonic() - self._started_at))
        minutes, seconds = divmod(elapsed, 60)
        display = f"{minutes} min {seconds} s" if minutes else f"{seconds} s"
        self.lbl_elapsed.setText(f"Tiempo transcurrido: {display}")

    @pyqtSlot(int, int, str, bool)
    def _on_progress_updated(
        self,
        cur: int,
        tot: int,
        message: str,
        indeterminate: bool = False,
    ):
        self.lbl_status.setText(message)
        if indeterminate:
            self.progress_bar.setRange(0, 0)
            return

        self.progress_bar.setRange(0, 100)
        if tot > 0:
            value = max(0, min(100, int((cur / tot) * 100)))
            self.progress_bar.setValue(value)

    @pyqtSlot(list, list)
    def _on_finished_success(self, temp_files: List[Path], warnings: List[str]):
        downloads_dir = config.DOWNLOADS
        downloads_dir.mkdir(parents=True, exist_ok=True)

        moved_count = 0
        for src_path in temp_files:
            if not src_path.exists():
                continue
            dest_candidate = downloads_dir / src_path.name
            dest_path = resolve_duplicate(dest_candidate)
            try:
                shutil.move(str(src_path), str(dest_path))
                moved_count += 1
            except Exception as e:
                logging.exception(f"Failed to move {src_path} to downloads: {e}")

        if self.worker:
            self.worker.cleanup_temp()

        # Handle UI notifications on main thread
        if self.task_type == "extract_images" and moved_count == 0 and not warnings:
            QtWidgets.QMessageBox.information(
                self.parentWidget(),
                "Extraer imágenes",
                "No se encontraron imágenes incrustadas en el PDF."
            )
        elif warnings:
            warn_msg = "\n".join(warnings)
            QtWidgets.QMessageBox.warning(
                self.parentWidget(),
                "Conversión finalizada con advertencias",
                f"Archivos guardados en Descargas: {moved_count}\n\n{warn_msg}"
            )
        elif moved_count == 0:
            QtWidgets.QMessageBox.information(
                self.parentWidget(),
                "Conversión",
                "No se generaron archivos."
            )

        self._elapsed_timer.stop()
        self._close_when_worker_has_stopped()

    @pyqtSlot(str)
    def _on_finished_error(self, err_msg: str):
        self._elapsed_timer.stop()
        if self.worker:
            self.worker.cleanup_temp()
        QtWidgets.QMessageBox.critical(
            self.parentWidget(),
            "Error en PDF",
            f"Ocurrió un error al procesar el archivo PDF:\n{err_msg}"
        )
        self._close_when_worker_has_stopped()

    @pyqtSlot()
    def _on_cancelled(self):
        self._elapsed_timer.stop()
        if self.worker:
            self.worker.cleanup_temp()
        self._close_when_worker_has_stopped()

    def _close_when_worker_has_stopped(self):
        """Close only after the QThread has stopped and can be safely deleted."""
        if self.worker and self.worker.isRunning():
            self._close_after_worker_stops = True
            return
        self.close()

    def _close_after_worker_finished(self):
        if self._close_after_worker_stops:
            self.close()

    def _on_cancel_clicked(self):
        if self.worker and self.worker.isRunning():
            self.lbl_status.setText(
                "Cancelación solicitada. Se está esperando a que termine la fase "
                "actual; Microsoft Word/FFmpeg pueden necesitar unos segundos para cerrarse…"
            )
            self.progress_bar.setRange(0, 0)
            self.btn_cancel.setEnabled(False)
            self.worker.request_cancellation()

    def closeEvent(self, event):
        if self.worker and self.worker.isRunning():
            # Do not destroy a QThread child while COM or FFmpeg is still running.
            # Word's synchronous SaveAs2 call cannot be interrupted safely mid-call.
            self._close_after_worker_stops = True
            self.worker.request_cancellation()
            self.btn_cancel.setEnabled(False)
            self.lbl_status.setText(
                "Cierre solicitado. La operación finalizará o cancelará su fase activa "
                "antes de cerrar esta ventana…"
            )
            self._elapsed_timer.start()
            event.ignore()
            return

        self._elapsed_timer.stop()
        event.accept()


def run_pdf_task(
    parent_widget: Optional[QtWidgets.QWidget],
    task_type: str,
    files: List[Path],
    title: str
):
    """
    Launches non-modal PDF operation dialog and background worker.
    """
    dpi = getattr(config, "PDF_DPI", 150)
    dialog = PDFProgressDialog(title, task_type, files, parent=parent_widget)
    dialog.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose)
    _ACTIVE_PDF_DIALOGS.add(dialog)
    dialog.destroyed.connect(lambda *_: _ACTIVE_PDF_DIALOGS.discard(dialog))
    dialog.start_task(dpi=dpi)
    return dialog
